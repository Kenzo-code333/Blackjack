{
  "name": "blackjack",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based multiplayer first-person 3D blackjack",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "play": "tsx scripts/play-cli.ts",
    "build:preview": "vite build -c vite.preview.config.ts && node scripts/assemble-preview.mjs"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.186.0",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "express": "^5.3.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "three": "^0.186.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
